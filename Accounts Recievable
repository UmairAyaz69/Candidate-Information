 const s=[[...cols,...(D.status?[]:["Status"]),"Notes"].map(q).join(",")].concat(r.map(o=>[...cols.map(c=>o[c]),...(D.status?[]:[stOf(o)]),(store[o._k]||{}).n||""].map(q).join(","))).join("\n");
 const a=document.createElement("a");a.href=URL.createObjectURL(new Blob([s],{type:"text/csv"}));a.download="candidates.csv";a.click()};
