<!DOCTYPE html>
<html lang="en"><head><meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>Recruit Hub Pro</title>
<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
<style>
:root{--ink:#1b1f3b;--mut:#5f6690;--ac:#5b5bf0;--ac2:#14b8a6;--gl:rgba(255,255,255,.5);--gb:rgba(255,255,255,.75)}
*{box-sizing:border-box;margin:0}
body{font-family:'Plus Jakarta Sans',system-ui,sans-serif;color:var(--ink);min-height:100vh;padding:20px;background:linear-gradient(120deg,#e3e9ff,#f5e6ff 50%,#dcf6ee) fixed;overflow-x:hidden}
.orb{position:fixed;border-radius:50%;filter:blur(70px);z-index:0;opacity:.7;animation:dr 22s ease-in-out infinite alternate}
.o1{width:460px;height:460px;background:#a5b4fc;top:-100px;right:10%}
.o2{width:400px;height:400px;background:#f9a8d4;bottom:-120px;left:5%;animation-delay:-8s}
.o3{width:320px;height:320px;background:#5eead4;top:45%;left:40%;opacity:.45;animation-delay:-14s}
@keyframes dr{to{transform:translate(50px,30px) scale(1.12)}}
.glass{background:linear-gradient(150deg,rgba(255,255,255,.62),rgba(255,255,255,.28));backdrop-filter:blur(26px) saturate(180%);-webkit-backdrop-filter:blur(26px) saturate(180%);border:1px solid var(--gb);border-radius:24px;box-shadow:0 12px 40px rgba(80,90,160,.16),inset 0 1px 0 #fff,inset 0 -1px 0 rgba(255,255,255,.4)}
.app{position:relative;z-index:1;max-width:1500px;margin:auto;display:grid;grid-template-columns:270px 1fr;gap:18px;align-items:start}
.side{padding:20px;position:sticky;top:20px;max-height:calc(100vh - 40px);overflow-y:auto}
.side h4{font-size:12px;color:var(--mut);font-weight:600;margin:16px 0 8px}
.side h4:first-child{margin-top:0}
.chips{display:flex;flex-wrap:wrap;gap:6px}
.chip{border:1px solid rgba(255,255,255,.9);background:rgba(255,255,255,.55);color:var(--ink);padding:6px 11px;border-radius:20px;font:500 12px inherit;font-family:inherit;cursor:pointer;transition:.18s}
.chip i{font-style:normal;color:var(--mut);margin-left:5px}
.chip:hover{background:#fff}
.chip.on{background:var(--ac);color:#fff;border-color:var(--ac);box-shadow:0 4px 14px rgba(91,91,240,.4)}
.chip.on i{color:#dfe0ff}
.rg{display:flex;gap:6px}
input,select,textarea{font-family:inherit;font-size:13px;color:var(--ink);background:rgba(255,255,255,.6);border:1px solid rgba(255,255,255,.95);border-radius:12px;padding:9px 12px;outline:none;min-width:0;width:100%}
input:focus,select:focus,textarea:focus{border-color:var(--ac);background:#fff}
.tg{display:flex;gap:8px;align-items:center;font-size:13px;margin-top:14px}
.tg input{width:auto}
.hd{padding:16px 20px;display:flex;gap:12px;align-items:center;flex-wrap:wrap;margin-bottom:14px}
.hd h1{font-size:22px;font-weight:800;letter-spacing:-.5px}
.sub{font-size:12px;color:var(--mut);margin-top:2px}
.hd .grow{flex:1 1 220px;min-width:180px}
.hd select{width:auto}
.seg{display:flex;background:rgba(255,255,255,.5);border-radius:14px;padding:3px}
.seg button{border:0;background:none;padding:8px 14px;border-radius:11px;font:600 13px inherit;font-family:inherit;color:var(--mut);cursor:pointer}
.seg button.on{background:#fff;color:var(--ac);box-shadow:0 2px 8px rgba(80,90,160,.2)}
.btn{border:1px solid rgba(255,255,255,.95);background:rgba(255,255,255,.6);padding:9px 14px;border-radius:12px;font:600 13px inherit;font-family:inherit;color:var(--ink);cursor:pointer;transition:.18s;display:inline-block}
.btn:hover{background:#fff}
.mob{display:none}.chips.sc{max-height:200px;overflow:auto;padding-right:4px}.help{padding:28px;line-height:1.7;font-size:14px}.help b{color:var(--ac)}
.badge{padding:10px 16px;margin-bottom:14px;font-size:12.5px;color:var(--mut);display:flex;gap:9px;align-items:center;border-radius:16px}
.dot{width:9px;height:9px;border-radius:50%;background:#10b981;box-shadow:0 0 10px #10b981;flex:none}
.dot.w{background:#f59e0b;box-shadow:0 0 10px #f59e0b}
.kpis{display:grid;grid-template-columns:repeat(auto-fit,minmax(170px,1fr));gap:12px;margin-bottom:14px}
.kpi{padding:16px 18px;border-radius:20px}
.kpi .l{font-size:12px;color:var(--mut);font-weight:500}
.kpi .v{font-size:28px;font-weight:800;margin-top:4px;letter-spacing:-1px}
.kpi .s{font-size:11.5px;color:var(--mut);margin-top:2px}
.cards{display:grid;grid-template-columns:repeat(auto-fill,minmax(290px,1fr));gap:14px}
.cd{padding:18px;cursor:pointer;transition:transform .2s,box-shadow .2s}
.cd:hover{transform:translateY(-3px)}
.top{display:flex;gap:12px;align-items:center}
.av{width:46px;height:46px;border-radius:15px;display:grid;place-items:center;color:#fff;font-weight:700;font-size:15px;flex:none}
.top h3{font-size:15px;font-weight:700;line-height:1.25}
.top p{font-size:12px;color:var(--mut);margin-top:2px}
.tm{margin-left:auto;background:rgba(91,91,240,.12);color:var(--ac);padding:5px 10px;border-radius:20px;font-size:12px;font-weight:700;white-space:nowrap}
.tm.no{background:rgba(0,0,0,.06);color:var(--mut);font-weight:500}
dl{display:grid;grid-template-columns:auto 1fr;gap:6px 12px;font-size:12.5px;margin:14px 0}
dt{color:var(--mut)}dd{font-weight:500;text-align:right;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.ft{display:flex;gap:8px;align-items:center}
.ft select{padding:7px 10px;font-weight:600}
.ic{width:36px;height:34px;display:grid;place-items:center;border-radius:11px;background:rgba(255,255,255,.7);text-decoration:none;font-size:12px;font-weight:700;color:var(--ink);flex:none}
.ic:hover{background:#fff}
.tw{padding:8px;overflow-x:auto}
table{width:100%;border-collapse:collapse;font-size:13px}
th{text-align:left;padding:12px;font-size:12px;color:var(--mut);font-weight:600;white-space:nowrap}
td{padding:12px;border-top:1px solid rgba(255,255,255,.7);white-space:nowrap}
tbody tr{cursor:pointer}tbody tr:hover{background:rgba(255,255,255,.55)}
.sp{display:inline-block;padding:3px 10px;border-radius:20px;font-size:12px;font-weight:600}
.sch{display:flex;flex-direction:column;gap:16px}
.slot{display:grid;grid-template-columns:86px 1fr;gap:14px}
.slot .t{font-weight:800;font-size:16px;padding-top:14px;text-align:right;color:var(--ac)}
.slot .l{display:flex;flex-direction:column;gap:10px;border-left:2px solid rgba(91,91,240,.25);padding-left:16px}
.mi{padding:12px 16px;border-radius:18px;display:flex;gap:12px;align-items:center;cursor:pointer;flex-wrap:wrap}
.mi b{font-size:14px}.mi span{font-size:12px;color:var(--mut)}
.empty{padding:50px;text-align:center;color:var(--mut)}
.modal{position:fixed;inset:0;z-index:9;background:rgba(40,45,90,.28);backdrop-filter:blur(6px);display:none;place-items:center;padding:16px}
.modal.open{display:grid}
.mc{width:min(560px,100%);max-height:92vh;overflow:auto;padding:26px}
.mc h2{font-size:21px;font-weight:800}
.grid2{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin:18px 0}
.fld{background:rgba(255,255,255,.5);border-radius:14px;padding:10px 13px}
.fld .k{font-size:11px;color:var(--mut)}.fld .v{font-size:13.5px;font-weight:600;margin-top:2px;word-break:break-word}
textarea{min-height:90px;resize:vertical;margin-top:8px}
:focus-visible{outline:2px solid var(--ac);outline-offset:2px}
@media(max-width:900px){.app{grid-template-columns:1fr}.side{display:none;position:static;max-height:none}.side.open{display:block}.mob{display:inline-block}}
@media(prefers-reduced-motion:reduce){*{animation:none!important;transition:none!important}}
</style></head>
<body>
<div class="orb o1"></div><div class="orb o2"></div><div class="orb o3"></div>
<div class="app">
<aside class="side glass" id="side"></aside>
<main>
<header class="glass hd">
 <div><h1>Recruit Hub</h1><div class="sub" id="sub"></div></div>
 <input class="grow" id="q" placeholder="Search name, company, phone…">
 <div class="seg" id="views"><button data-v="cards" class="on">Cards</button><button data-v="table">Table</button><button data-v="sched">Schedule</button></div>
 <select id="sortby"><option value="sr">Sheet order</option><option value="name">Name A–Z</option><option value="time">Interview time</option><option value="exp">Most experienced</option></select>
 <button class="btn mob" id="fb">Filters</button>
 <button class="btn" id="sync">Sync</button><button class="btn" id="tabs">Tabs</button><label class="btn">Load CSV<input type="file" id="file" accept=".csv,text/csv" multiple hidden></label>
 <button class="btn" id="ex">Export</button>
</header>
<div class="glass badge" id="badge"></div>
<section class="kpis" id="kpis"></section>
<section id="view"></section>
</main></div>
<div class="modal" id="md"></div>
<script>
const ID="1756J5ylA8V4RHB5yYzjJ4pvJJEiCGfJwjRNf3HO68uk",EVERY=60000;
const TABS=["Sheet1","QA&CERD","MECH SKP","Chem Engineer","SC","Mechanical Technician","Hr Exec","Internal Audit K","Taxation","CPP","MS coordinator","Invoicing","Import Executive","Invoice Officer","Account Recievable","R&D","IT LHR","IA SKP Executive","Bank letter issuance","Mechanical Engr.LHR","DAE Mech LHR","SI Elec SKP","DAE Mech SKP","SI Mech SKP","Treasury Kch","Operator","Mechanical Engineer","Monday DAE's","CSR KCH","Sheet1 (1)","Headpacker","Recycling","Sales Support","AM Treasury","Process Engineer","Operator Filmline","Time Officer","IT KHE","Maintenance Engineer","Manager Logistics","Procurement","Treasury Officer"];
const getTabs=()=>{try{const t=JSON.parse(localStorage.getItem("rhtabs"));if(Array.isArray(t)&&t.length)return t}catch(e){}return TABS};
const $=s=>document.querySelector(s),esc=s=>String(s??"").replace(/[&<>"]/g,m=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;"}[m]));
const ST=["New","Shortlisted","Hold","Rejected","Hired"],SC={New:"#6366f1",Shortlisted:"#10b981",Hold:"#f59e0b",Rejected:"#ef4444",Hired:"#0ea5e9"};
const AVC=["#6366f1,#8b5cf6","#0ea5e9,#14b8a6","#ec4899,#f97316","#10b981,#0ea5e9","#f59e0b,#ef4444","#8b5cf6,#ec4899"];
const mk=()=>({q:"",batch:new Set,edu:new Set,exp:new Set,slot:new Set,st:new Set,pos:new Set,org:false,smin:"",smax:""});
let cols=[],rows=[],D={},last="",src="",view="cards",sortBy="sr",S=mk(),store={};
try{store=JSON.parse(localStorage.getItem("rh")||"{}")}catch(e){}
const save=()=>{try{localStorage.setItem("rh",JSON.stringify(store))}catch(e){}};
const stOf=o=>{if(D.status){const v=(o[D.status]||"").toLowerCase().replace(/[^a-z]/g,"");return ST.find(s=>s.toLowerCase()===v)||ST.find(s=>v&&s.toLowerCase().startsWith(v))||"New"}return(store[o._k]||{}).s||"New"};

function parseCSV(t){const r=[];let row=[],f="",q=false;
for(let i=0;i<t.length;i++){const c=t[i];
if(q){if(c=='"'){if(t[i+1]=='"'){f+='"';i++}else q=false}else f+=c}
else if(c=='"')q=true;else if(c==','){row.push(f);f=""}
else if(c=='\n'||c=='\r'){if(c=='\r'&&t[i+1]=='\n')i++;row.push(f);r.push(row);row=[];f=""}
else f+=c}
if(f||row.length){row.push(f);r.push(row)}
return r.filter(x=>x.some(v=>v.trim()))}
const EMPTY=/^(_+|-+|—|n\/?a|nil|none|null|nan|\.)?$/i;
const clean=v=>{v=String(v||"").trim();return EMPTY.test(v)?"":v};
function num(s,yrs){s=String(s||"").replace(/,/g,"");
 if(yrs){const y=s.match(/(\d+(\.\d+)?)\s*y/i),m=s.match(/(\d+(\.\d+)?)\s*m/i);
  if(!y&&!m){const n=s.match(/\d+(\.\d+)?/);return n?parseFloat(n[0]):NaN}
  return(y?parseFloat(y[1]):0)+(m?parseFloat(m[1])/12:0)}
 const m=s.match(/\d+(\.\d+)?/);if(!m)return NaN;let n=parseFloat(m[0]);
 if(/lac|lakh|\blk\b/i.test(s))n*=1e5;else if(/\d\s*k\b/i.test(s))n*=1e3;else if(/\d\s*m(illion)?\b/i.test(s))n*=1e6;return n}
function tmin(s){s=String(s||"");const m=s.match(/(\d{1,2})[:.](\d{2})\s*([ap])?/i)||s.match(/^\s*(\d{1,2})()\s*([ap])m?\s*$/i);if(!m)return NaN;
 let h=+m[1],mi=+(m[2]||0),ap=(m[3]||"").toLowerCase();
 if(ap==="p"&&h<12)h+=12;else if(ap==="a"&&h===12)h=0;
 if(ap==="p"&&h>=20)h-=12;else if(!ap&&h>=1&&h<=6)h+=12;
 return h*60+mi}
const ft=t=>{if(isNaN(t))return"";const h=Math.floor(t/60),m=t%60;return(h%12||12)+":"+String(m).padStart(2,"0")+" "+(h>=12?"PM":"AM")};
const money=n=>isNaN(n)?"—":Math.round(n).toLocaleString();
const bk=o=>isNaN(o._exp)?"Unknown":o._exp<1?"Under 1 yr":o._exp<3?"1–3 yrs":o._exp<5?"3–5 yrs":"5+ yrs";
const sk=o=>isNaN(o._t)?"none":String(Math.floor(o._t/60));
const g=(o,c)=>(c&&o[c])||"";

const CAN=[["sr",/^sr/i,"Sr No."],["batch",/batch/i,"Batch No"],["name",/name/i,"Candidate Name"],["tel",/contact|phone|mobile|cell/i,"Contact number"],["edu",/educ|qualif|degree/i,"Education"],["exp",/experience/i,"Total Experience"],["org",/organi[sz]ation|company|employer/i,"Current/Last organisation"],["des",/designation|position|title/i,"Current/ Last designation"],["cur",/current.*(salary|pay|ctc)|^\s*(salary|pay|ctc)\s*$/i,"Current Salary"],["ben",/benefit/i,"Benefits"],["exs",/expect/i,"Expected salary"],["int",/interview|^\s*(time|slot)\s*$/i,"Interview Time"],["status",/status|stage/i,"Status"]];
D={sr:"Sr No.",batch:"Batch No",name:"Candidate Name",tel:"Contact number",edu:"Education",exp:"Total Experience",org:"Current/Last organisation",des:"Current/ Last designation",cur:"Current Salary",ben:"Benefits",exs:"Expected salary",int:"Interview Time",status:"Status",pos:"Position"};
const canon=h=>{h=String(h||"").trim();if(!h)return null;for(const[k,re,n]of CAN){if(k==="name"&&/organi|design/i.test(h))continue;if(re.test(h))return n}return h};
function findHeader(a){for(let i=0;i<Math.min(a.length,6);i++){const r=a[i]||[];if(r.filter(x=>String(x||"").trim()).length>=3&&r.some(x=>/name/i.test(String(x||""))))return i}return 0}
function tabRows(name,head,body){const idx=[],names=[];
 head.forEach((h,i)=>{const c=canon(h);if(c&&!names.includes(c)){idx.push(i);names.push(c)}});
 if(!names.includes(D.name))return[];
 return body.map(r=>{const o={};idx.forEach((i,j)=>o[names[j]]=clean(r[i]));o[D.pos]=name.trim();return o}).filter(o=>o[D.name]&&!/^candidate\s*name$/i.test(o[D.name]))}
function ingestTabs(list){
 const all=[];list.forEach(([n,hd,b])=>tabRows(n,hd,b).forEach(o=>all.push(o)));
 const seen=new Set;all.forEach(o=>Object.keys(o).forEach(k=>seen.add(k)));
 const base=[D.sr,D.batch,D.name,D.tel,D.edu,D.exp,D.org,D.des,D.cur,D.ben,D.exs,D.int,D.status,D.pos];
 cols=[...base.filter(c=>seen.has(c)),...[...seen].filter(c=>!base.includes(c))];
 rows=all.map((o,n)=>{o._i=n;o._exp=num(o[D.exp],1);o._cur=num(o[D.cur]);o._exs=num(o[D.exs]);
  o._t=tmin(o[D.int]);o._k=((g(o,D.tel).replace(/\s/g,"")||g(o,D.name))+"|"+o[D.pos]).toLowerCase();
  o._s=cols.map(c=>o[c]).join(" ").toLowerCase();return o});
 buildSide();render();return rows.length}
let JP=0,busy=false;
function gv(sheet){return new Promise(res=>{const cb="__gv"+(++JP),s=document.createElement("script");let to;
 const fin=v=>{clearTimeout(to);delete window[cb];s.remove();res(v)};
 to=setTimeout(()=>fin(null),15000);window[cb]=v=>fin(v);s.onerror=()=>fin(null);
 s.src=`https://docs.google.com/spreadsheets/d/${ID}/gviz/tq?tqx=out:json;responseHandler:${cb}&sheet=${encodeURIComponent(sheet)}&headers=1&_=${Date.now()}`;
 document.head.appendChild(s)})}
function fromGv(v){const cs=v.table.cols.map(c=>c.label||""),rs=v.table.rows.map(r=>(r.c||[]).map(c=>c?(c.f??c.v??""):""));
 const all=[cs,...rs],hi=findHeader(all);return[all[hi]||[],all.slice(hi+1)]}
function badge(live,msg){$("#badge").innerHTML=`<span class="dot ${live?"":"w"}"></span><span>${msg}</span>`}
const HELP=`<div class="glass help"><b>Couldn't read the sheet yet.</b><br>1. In Google Sheets press <b>Share</b> → General access → <b>Anyone with the link</b> → <b>Viewer</b>.<br>2. Open this file in a normal browser tab (Chrome, Edge, Safari) and press <b>Sync</b>.<br>3. Tab names can be edited with the <b>Tabs</b> button. Or export tabs as CSV and use <b>Load CSV</b> (you can select many files).</div>`;
async function refresh(){
 if(src==="file"||busy)return;busy=true;
 const tabs=getTabs(),res=new Array(tabs.length);let done=0;
 for(let i=0;i<tabs.length;i+=8)await Promise.all(tabs.slice(i,i+8).map(async(t,j)=>{const v=await gv(t);done++;
  if(v&&v.status!=="error"&&v.table)res[i+j]=[t,...fromGv(v)];if(!rows.length)badge(false,`Reading tabs ${done}/${tabs.length}…`)}));
 busy=false;
 const out=res.filter(Boolean);
 if(out.length){const key=JSON.stringify(out);if(key!==last||src!=="live"){last=key;src="live";ingestTabs(out)}
  badge(true,`Live from Google Sheets · ${rows.length} candidates across ${new Set(rows.map(o=>o[D.pos])).size} positions · synced ${new Date().toLocaleTimeString()}`)}
 else if(!rows.length){badge(false,"Couldn't connect to Google Sheets.");$("#view").innerHTML=HELP}
 else badge(false,"Connection lost. Showing the last synced data and retrying…")}

function buildSide(){
 const cnt=(fn,l=v=>v)=>{const m={};rows.forEach(o=>{const v=fn(o);if(v!==""&&v!=null)m[v]=(m[v]||0)+1});return Object.entries(m)};
 const num_=(a,b)=>String(a[0]).localeCompare(String(b[0]),undefined,{numeric:true});
 const G=[];
 if(D.batch)G.push(["Batch","batch",cnt(o=>g(o,D.batch)).sort(num_),v=>"Batch "+v]);
 if(D.edu)G.push(["Education","edu",cnt(o=>g(o,D.edu)).sort((a,b)=>b[1]-a[1]),v=>v]);
 if(D.exp)G.push(["Experience","exp",["Unknown","Under 1 yr","1–3 yrs","3–5 yrs","5+ yrs"].map(b=>[b,rows.filter(o=>bk(o)===b).length]).filter(x=>x[1]),v=>v]);
 if(D.int)G.push(["Interview slot","slot",cnt(sk).sort((a,b)=>a[0]==="none"?1:b[0]==="none"?-1:a[0]-b[0]),v=>v==="none"?"Unscheduled":ft(v*60).replace(":00","")]);
 G.push(["Status","st",ST.map(s=>[s,rows.filter(o=>stOf(o)===s).length]),v=>v]);
 G.unshift(["Position","pos",cnt(o=>g(o,D.pos)).sort((a,b)=>b[1]-a[1]),v=>v]);
 let h=G.filter(x=>x[2].length).map(([t,k,arr,lab])=>`<h4>${t}</h4><div class="chips ${k==="pos"?"sc":""}">${arr.map(([v,n])=>`<button class="chip ${S[k].has(String(v))?"on":""}" data-g="${k}" data-v="${esc(v)}">${esc(lab(v))}<i>${n}</i></button>`).join("")}</div>`).join("");
 if(rows.some(o=>!isNaN(o._exs)))h+=`<h4>Expected salary</h4><div class="rg"><input type="number" id="smin" placeholder="Min" value="${S.smin}"><input type="number" id="smax" placeholder="Max" value="${S.smax}"></div>`;
 h+=`<label class="tg"><input type="checkbox" id="org" ${S.org?"checked":""}> Only with company info</label><button class="btn" id="rs" style="margin-top:16px;width:100%">Reset filters</button>`;
 $("#side").innerHTML=h;
}
$("#side").addEventListener("click",e=>{const c=e.target.closest(".chip");
 if(c){const s=S[c.dataset.g],v=c.dataset.v;s.has(v)?s.delete(v):s.add(v);c.classList.toggle("on");render();return}
 if(e.target.id==="rs"){S=mk();$("#q").value="";buildSide();render()}});
$("#side").addEventListener("input",e=>{if(e.target.id==="smin")S.smin=e.target.value;if(e.target.id==="smax")S.smax=e.target.value;if(e.target.id==="org")S.org=e.target.checked;render()});
$("#q").oninput=e=>{S.q=e.target.value;render()};
$("#sortby").onchange=e=>{sortBy=e.target.value;render()};
$("#views").onclick=e=>{const b=e.target.closest("button");if(!b)return;view=b.dataset.v;document.querySelectorAll("#views button").forEach(x=>x.classList.toggle("on",x===b));render()};
$("#fb").onclick=()=>$("#side").classList.toggle("open");
$("#file").onchange=async e=>{const fs=[...e.target.files];if(!fs.length)return;
 const list=await Promise.all(fs.map(f=>f.text().then(t=>{const p=parseCSV(t),hi=findHeader(p);return[f.name.replace(/\.csv$/i,""),p[hi]||[],p.slice(hi+1)]})));
 src="file";const n=ingestTabs(list);badge(false,`Showing ${n} candidates from ${fs.length} uploaded file(s). Auto-sync is paused; press Sync to return to live data.`)};
$("#sync").onclick=()=>{src="";last="";refresh()};
$("#tabs").onclick=()=>{const v=prompt("Sheet tab names, separated by commas:",getTabs().join(", "));if(v!==null){try{localStorage.setItem("rhtabs",JSON.stringify(v.split(",").map(s=>s.trim()).filter(Boolean)))}catch(e){}src="";last="";refresh()}};

function filtered(){
 const q=S.q.toLowerCase();
 let r=rows.filter(o=>{
  if(q&&!o._s.includes(q))return false;
  if(S.pos.size&&!S.pos.has(g(o,D.pos)))return false;
  if(S.batch.size&&!S.batch.has(g(o,D.batch)))return false;
  if(S.edu.size&&!S.edu.has(g(o,D.edu)))return false;
  if(S.exp.size&&!S.exp.has(bk(o)))return false;
  if(S.slot.size&&!S.slot.has(sk(o)))return false;
  if(S.st.size&&!S.st.has(stOf(o)))return false;
  if(S.org&&!(g(o,D.org)||g(o,D.des)))return false;
  if(S.smin!==""&&!(o._exs>=+S.smin))return false;
  if(S.smax!==""&&!(o._exs<=+S.smax))return false;
  return true});
 const cmp={sr:(a,b)=>a._i-b._i,name:(a,b)=>a[D.name].localeCompare(b[D.name]),time:(a,b)=>(isNaN(a._t)?1e9:a._t)-(isNaN(b._t)?1e9:b._t),exp:(a,b)=>(isNaN(b._exp)?-1:b._exp)-(isNaN(a._exp)?-1:a._exp)}[sortBy];
 return r.sort(cmp)}
const ini=n=>n.split(/\s+/).slice(0,2).map(w=>w[0]).join("").toUpperCase();
const av=n=>{let h=0;for(const c of n)h=(h*31+c.charCodeAt(0))%AVC.length;return`background:linear-gradient(135deg,${AVC[h]})`};
const sp=s=>`<span class="sp" style="color:${SC[s]};background:${SC[s]}22">${s}</span>`;
const stSel=o=>D.status?sp(stOf(o)):`<select class="st" data-k="${esc(o._k)}">${ST.map(s=>`<option ${stOf(o)===s?"selected":""}>${s}</option>`).join("")}</select>`;
const wa=o=>{let d=g(o,D.tel).replace(/\D/g,"");if(d.startsWith("0"))d="92"+d.slice(1);return d};

function render(){
 const r=filtered();
 $("#sub").textContent=`${r.length} of ${rows.length} candidates`;
 const sc=r.filter(o=>!isNaN(o._t)),ex=r.map(o=>o._exp).filter(x=>!isNaN(x));
 const fl=rows.length*[D.org,D.des,D.cur,D.exs].filter(Boolean).length,fd=rows.reduce((a,o)=>a+[D.org,D.des,D.cur,D.exs].filter(c=>c&&o[c]).length,0);
 const K=[["Candidates",r.length,"of "+rows.length+" total"],
  ["Interviews scheduled",sc.length,sc.length?ft(Math.min(...sc.map(o=>o._t)))+" – "+ft(Math.max(...sc.map(o=>o._t))):"no slots yet"],
  ["Avg experience",ex.length?(ex.reduce((a,b)=>a+b,0)/ex.length).toFixed(1)+" yrs":"—","in this view"],
  ["Shortlisted",r.filter(o=>stOf(o)==="Shortlisted").length,r.filter(o=>stOf(o)==="Hired").length+" hired"],
  ["Profile completeness",fl?Math.round(fd/fl*100)+"%":"—","company, role, salary"],["Positions",new Set(r.map(o=>g(o,D.pos))).size,"with candidates"]];
 const cs=ST.map(s=>[s,r.filter(o=>stOf(o)===s).length]);
 $("#kpis").innerHTML=K.map(k=>`<div class="glass kpi"><div class="l">${k[0]}</div><div class="v">${k[1]}</div><div class="s">${esc(k[2])}</div></div>`).join("")+`<div class="glass kpi" style="grid-column:1/-1"><div class="l">Hiring pipeline</div><div style="display:flex;height:12px;border-radius:8px;overflow:hidden;margin:10px 0 8px;background:rgba(0,0,0,.06)">${cs.map(([s,n])=>n?`<div title="${s}: ${n}" style="flex:${n};background:${SC[s]}"></div>`:"").join("")}</div><div style="display:flex;gap:14px;flex-wrap:wrap;font-size:12px;color:var(--mut)">${cs.map(([s,n])=>`<span><b style="color:${SC[s]}">●</b> ${s} ${n}</span>`).join("")}</div></div>`;
 const V=$("#view");
 if(!r.length){V.innerHTML='<div class="glass empty">No candidates match. Clear a filter or press Reset.</div>';return}
 if(view==="cards")V.innerHTML='<div class="cards">'+r.map(o=>`<article class="glass cd" data-k="${esc(o._k)}"><div class="top"><div class="av" style="${av(o[D.name])}">${esc(ini(o[D.name]))}</div><div><h3>${esc(o[D.name])}</h3><p>${esc([g(o,D.pos),g(o,D.edu)].filter(Boolean).join(" · "))}</p></div><span class="tm ${isNaN(o._t)?"no":""}">${isNaN(o._t)?"Unscheduled":ft(o._t)}</span></div>
  <dl><dt>Experience</dt><dd>${esc(g(o,D.exp)||"—")}</dd><dt>Company</dt><dd>${esc(g(o,D.org)||"—")}</dd><dt>Role</dt><dd>${esc(g(o,D.des)||"—")}</dd><dt>Expected salary</dt><dd>${isNaN(o._exs)?"—":money(o._exs)}</dd></dl>
  <div class="ft">${stSel(o)}<span style="flex:1"></span>${g(o,D.tel)?`<a class="ic" href="tel:${esc(g(o,D.tel).replace(/\s/g,""))}" title="Call">Call</a><a class="ic" href="https://wa.me/${wa(o)}" target="_blank" rel="noopener" title="WhatsApp">WA</a>`:""}</div></article>`).join("")+"</div>";
 else if(view==="table")V.innerHTML=`<div class="glass tw"><table><thead><tr>${["#","Candidate","Position","Batch","Education","Experience","Company","Role","Current","Expected","Interview","Status","Contact"].map(h=>`<th>${h}</th>`).join("")}</tr></thead><tbody>${r.map(o=>`<tr data-k="${esc(o._k)}"><td>${o._i+1}</td><td><b>${esc(o[D.name])}</b></td><td>${esc(g(o,D.pos))}</td><td>${esc(g(o,D.batch)||"—")}</td><td>${esc(g(o,D.edu)||"—")}</td><td>${esc(g(o,D.exp)||"—")}</td><td>${esc(g(o,D.org)||"—")}</td><td>${esc(g(o,D.des)||"—")}</td><td>${money(o._cur)}</td><td>${money(o._exs)}</td><td>${isNaN(o._t)?"—":ft(o._t)}</td><td>${sp(stOf(o))}</td><td>${esc(g(o,D.tel)||"—")}</td></tr>`).join("")}</tbody></table></div>`;
 else{const by={};r.forEach(o=>{const k=sk(o);(by[k]=by[k]||[]).push(o)});
  const ks=Object.keys(by).sort((a,b)=>a==="none"?1:b==="none"?-1:a-b);
  V.innerHTML='<div class="sch">'+ks.map(k=>`<div class="slot"><div class="t">${k==="none"?"Unscheduled":ft(k*60).replace(":00","")}</div><div class="l">${by[k].sort((a,b)=>(a._t||0)-(b._t||0)).map(o=>`<div class="glass mi" data-k="${esc(o._k)}"><b>${isNaN(o._t)?"":ft(o._t)}</b><b>${esc(o[D.name])}</b><span>${esc(g(o,D.edu))}${g(o,D.org)?" · "+esc(g(o,D.org)):""}</span><span style="margin-left:auto">${sp(stOf(o))}</span></div>`).join("")}</div></div>`).join("")+"</div>"}
}
$("#view").addEventListener("click",e=>{if(e.target.closest("select,a"))return;const c=e.target.closest("[data-k]");if(c)openM(c.dataset.k)});
$("#view").addEventListener("change",e=>{const s=e.target.closest("select.st");if(!s)return;(store[s.dataset.k]=store[s.dataset.k]||{}).s=s.value;save();render()});
function openM(k){const o=rows.find(x=>x._k===k);if(!o)return;
 $("#md").innerHTML=`<div class="glass mc"><div class="top"><div class="av" style="${av(o[D.name])}">${esc(ini(o[D.name]))}</div><div><h2>${esc(o[D.name])}</h2><p class="sub">${esc([g(o,D.des),g(o,D.org)].filter(Boolean).join(" at "))}</p></div><button class="btn" id="cl" style="margin-left:auto">Close</button></div>
 <div class="grid2">${cols.filter(c=>c!==D.name&&c!==D.status).map(c=>`<div class="fld"><div class="k">${esc(c)}</div><div class="v">${o[c]?(c===D.int&&!isNaN(o._t)?ft(o._t):esc(o[c])):"—"}</div></div>`).join("")}</div>
 <div class="sub">Status</div><div style="margin:6px 0 12px">${stSel(o)}</div><div class="sub">Recruiter notes (saved in this browser)</div><textarea id="nt" placeholder="Add notes about this candidate…">${esc((store[k]||{}).n||"")}</textarea></div>`;
 $("#md").classList.add("open");
 $("#nt").oninput=e=>{(store[k]=store[k]||{}).n=e.target.value;save()};
 $("#md").querySelector("select.st").onchange=e=>{(store[k]=store[k]||{}).s=e.target.value;save();render()};
 $("#cl").onclick=closeM}
const closeM=()=>$("#md").classList.remove("open");
$("#md").onclick=e=>{if(e.target.id==="md")closeM()};
document.addEventListener("keydown",e=>{if(e.key==="Escape")closeM()});
